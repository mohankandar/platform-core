<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.documentplatform.platform</groupId>
        <artifactId>platform-core</artifactId>
        <version>1.1.1-SNAPSHOT</version>
    </parent>
    <artifactId>platform-app-check</artifactId>
    <description>Build check only (never deployed, not in the BOM): an app as Spring Boot 4.2 makes it, with Boot's own
        dependency management and starters, that uses every module (P051).</description>
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- As an app does: Boot's versions and ours, one BOM each. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.documentplatform.platform</groupId>
                <artifactId>platform-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-crypto-spring</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-erase-log-spring</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-identity-spring</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-identity-jdbc</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-integration-spring</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-licensing-spring</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-model-governance-spring</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-monitoring-spring</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-notifications-spring</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-outbound-spring</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-fields</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-setup</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-licensing-testkit</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-crypto-testkit</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-identity-testkit</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-integration-testkit</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-notifications-testkit</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-fields-testkit</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-erase-log-testkit</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-monitoring-testkit</artifactId><scope>test</scope></dependency>
