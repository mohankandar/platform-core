{
  "openapi": "3.1.0",
  "info": {"title": "Example DMS", "version": "2.0", "description": "A made-up API for tests."},
  "paths": {
    "/api/v2/status": {
      "get": {
        "operationId": "status",
        "responses": {
          "200": {"description": "Up", "content": {"application/json": {"schema": {"type": "object", "required": ["up"], "properties": {"up": {"type": "boolean"}}}}}},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    },
    "/api/v2/packages": {
      "post": {
        "operationId": "uploadPackage",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["metadata", "files"],
                "properties": {
                  "metadata": {"$ref": "#/components/schemas/PackageMetadata"},
                  "files": {"type": "array", "items": {"type": "string", "contentMediaType": "application/pdf"}}
                }
              }
            }
          }
        },
        "responses": {
          "201": {"description": "Stored", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Package"}}}},
          "400": {"description": "Bad request", "x-error-codes": ["DMS-INVALID", "DMS-TOO-MANY"], "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "409": {"description": "Already stored", "x-error-codes": ["DMS-DUPLICATE"], "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "429": {"description": "Too many requests"},
          "500": {"description": "Failure", "x-error-codes": ["DMS-INTERNAL"], "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    }
  },
  "components": {
    "responses": {
      "Forbidden": {"description": "Key refused", "x-error-codes": ["DMS-KEY"], "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    },
    "schemas": {
      "PackageMetadata": {
        "type": "object",
        "required": ["package", "files"],
        "additionalProperties": false,
        "properties": {
          "package": {"type": "string", "minLength": 1},
          "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "sha256"], "properties": {"name": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
          "index": {"type": "object"}
        }
      },
      "Package": {"type": "object", "required": ["packageId", "stored"], "properties": {"packageId": {"type": "string"}, "stored": {"type": "integer"}}},
      "Error": {
        "type": "object", "required": ["error"],
        "properties": {"error": {"type": "object", "required": ["code"], "properties": {"code": {"type": "string"}, "text": {"type": "string"}}}}
      }
    }
  }
}
