<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.documentplatform.platform</groupId>
        <artifactId>platform-core</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>
    <artifactId>platform-integration-testkit</artifactId>
    <description>Test support for platform-integration: the mock destination server (JDK HttpServer, switched per test
        or by a small admin call, with its own token endpoint; records headers, fields and checksums, never document
        text), a test proxy, test certificates and the in-memory configuration store. For the apps' tests only (test
        scope); never on a production classpath.</description>
    <dependencies>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-integration</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-notifications-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The https mock issuer test (OutboundIssuerFetch with the private CA). -->
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <!-- Every test but the CONNECT proxy sign-in one, in a JVM with the JDK's defaults (Basic disabled
                         for tunnels): ProxySignInTest proves INT_PROXY_SIGN_IN_DISABLED_BY_JVM there. -->
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/ProxySignInTunnelTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!-- The CONNECT proxy sign-in, in its own JVM started as the install guide tells the customer. -->
                    <execution>
                        <id>proxy-sign-in-tunnel</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <argLine>-Djdk.http.auth.tunneling.disabledSchemes=</argLine>
                            <includes>
                                <include>**/ProxySignInTunnelTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
