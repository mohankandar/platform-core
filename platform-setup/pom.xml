<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.documentplatform.platform</groupId>
        <artifactId>platform-core</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>platform-setup</artifactId>
    <description>The setup command (SetupCommand), direct sign-in mode: reads the signed licence, the sign-in file
        (platform-signin/1), the role mapping file and the product's product-roles.json, checks everything first, prints a
        plan, then stores the licence, the customer, the entity slots, the login connection and the group grants in one
        transaction per product database, writes the tenant-id config fragment and a run log. Plain Java, no Spring. The
        product's distribution supplies the PostgreSQL JDBC driver.</description>
    <dependencies>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-licensing</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-licensing-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
