<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.documentplatform.platform</groupId>
        <artifactId>platform-core</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>
    <artifactId>platform-setup</artifactId>
    <description>The setup command (SetupCommand), direct sign-in mode: reads the signed licence, the sign-in file
        (platform-signin/1), the role mapping file and the product's product-roles.json, checks everything first, prints a
        plan, then stores the licence, the customer, the entity slots, the login connection and the group grants in one
        transaction per product database, creates the customer's keys in the key service (left alone when they exist),
        writes the tenant-id config fragment and a run log. Plain Java, no Spring. The
        product's distribution supplies the PostgreSQL JDBC driver.</description>
    <dependencies>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-licensing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Integration profiles named in the sign-in file are checked (ProfileValidator), never stored. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-integration</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The customer's keys in the key service (Vault Transit), created by setup apply. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-crypto</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-licensing-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-crypto-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <!-- java -jar works with the dependencies in the same folder (P051). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.documentplatform.setup.SetupCommand</mainClass>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
