<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.documentplatform.platform</groupId>
    <artifactId>platform-core</artifactId>
    <version>1.1.1</version>
    <packaging>pom</packaging>
    <name>platform-core</name>
    <description>Shared platform libraries for document products</description>
    <modules>
        <module>platform-bom</module>
        <module>platform-errors</module>
        <module>platform-identity-core</module>
        <module>platform-identity-spring</module>
        <module>platform-notifications</module>
        <module>platform-notifications-testkit</module>
        <module>platform-notifications-spring</module>
        <module>platform-licensing</module>
        <module>platform-licensing-issue</module>
        <module>platform-licensing-testkit</module>
        <module>platform-licensing-spring</module>
        <module>platform-identity-jdbc</module>
        <module>platform-identity-testkit</module>
        <module>platform-setup</module>
        <module>platform-fields</module>
        <module>platform-fields-testkit</module>
        <module>platform-crypto</module>
        <module>platform-crypto-testkit</module>
        <module>platform-crypto-spring</module>
        <module>platform-erase-log</module>
        <module>platform-erase-log-testkit</module>
        <module>platform-erase-log-spring</module>
        <module>platform-outbound</module>
        <module>platform-outbound-spring</module>
        <module>platform-integration</module>
        <module>platform-integration-testkit</module>
        <module>platform-integration-spring</module>
        <module>platform-monitoring</module>
        <module>platform-monitoring-testkit</module>
        <module>platform-monitoring-spring</module>
        <module>platform-model-governance</module>
        <module>platform-model-governance-testkit</module>
        <module>platform-model-governance-spring</module>
        <module>platform-app-check</module>
        <module>platform-error-catalogue</module>
    </modules>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.security.version>7.2.0</spring.security.version>
        <!-- The platform baseline (P046): Spring Boot 4.2, with what it manages (Framework 7.1, Security 7.2). Pinned, not imported, so
             platform-bom never brings Boot's versions into an app: the app's own Boot 4.2 version wins. docs/design/platform-baseline.md -->
        <spring.boot.version>4.2.0</spring.boot.version>
        <spring.framework.version>7.1.0</spring.framework.version>
        <micrometer.version>1.18.0</micrometer.version>
        <servlet.version>6.1.0</servlet.version>
        <slf4j.version>2.0.20</slf4j.version>
        <logback.version>1.6.6</logback.version>
        <assertj.version>3.27.7</assertj.version>
        <junit.version>6.1.3</junit.version>
        <angus.mail.version>2.0.5</angus.mail.version>
        <greenmail.version>2.1.15</greenmail.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <postgresql.version>42.7.14</postgresql.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <!-- The integrations' HTTP client (connection pinning): the version Spring Boot 4.2 manages. -->
        <httpclient5.version>5.6.5</httpclient5.version>
        <!-- Declared where used, so the published POMs carry it (P043): httpcore as Boot 4.2 manages it. Nimbus comes with Spring Security. -->
        <httpcore5.version>5.4.4</httpcore5.version>
    </properties>
    <distributionManagement>
        <!-- Releases only (tags platform-core-vX.Y.Z, published by .github/workflows/release.yml). -->
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/mohankandar/platform-core</url>
        </repository>
    </distributionManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <release>21</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
