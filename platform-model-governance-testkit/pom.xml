<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.documentplatform.platform</groupId>
        <artifactId>platform-core</artifactId>
        <version>1.2.0</version>
    </parent>
    <artifactId>platform-model-governance-testkit</artifactId>
    <description>Test support for model governance: an in-memory register and gate store with the same rules as the
        Postgres one, fixtures for a made-up use and model, a recording audit and a fake model server for the
        manifest-digest adapter. Holds the module's tests against both stores. For the apps' tests only (test scope);
        never on a production classpath.</description>
    <dependencies>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-model-governance</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- The pack's JSON is checked against its schema with the integration module's JSON Schema check. -->
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-integration</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
