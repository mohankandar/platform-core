<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.sample</groupId>
        <artifactId>sample-app-parent</artifactId>
        <version>1</version>
    </parent>
    <artifactId>sample-app</artifactId>
    <properties>
        <!-- The build time in licence-build.properties. -->
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <built.at>${maven.build.timestamp}</built.at>
    </properties>
    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-errors</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-identity-jdbc</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-identity-spring</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-licensing-spring</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-notifications-spring</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-fields</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-crypto-spring</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-erase-log-spring</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-outbound-spring</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-integration-spring</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-monitoring-spring</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-model-governance-spring</artifactId></dependency>
        <dependency><groupId>com.documentplatform.platform</groupId><artifactId>platform-setup</artifactId></dependency>
    </dependencies>
    <build>
        <finalName>sample-app</finalName>
        <resources>
            <resource><directory>src/main/resources</directory><filtering>false</filtering>
                <excludes><exclude>META-INF/platform/licence-build.properties</exclude></excludes></resource>
            <resource><directory>src/main/resources</directory><filtering>true</filtering>
                <includes><include>META-INF/platform/licence-build.properties</include></includes></resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.example.sample.SampleApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
