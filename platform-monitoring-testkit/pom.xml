<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.documentplatform.platform</groupId>
        <artifactId>platform-core</artifactId>
        <version>0.7.0-SNAPSHOT</version>
    </parent>
    <artifactId>platform-monitoring-testkit</artifactId>
    <description>Test support for monitoring: SwitchableCheck (a check whose state a test sets, or that throws or
        hangs), RecordingEvents, MockHttpService (a JDK HttpServer health address with switches: up, down, status,
        slow). Holds the tests of the built-in checks against the other modules' mocks. Test scope only.</description>
    <dependencies>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-monitoring</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-crypto-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-licensing-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-notifications-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-jdbc</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-spring</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-integration-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-licensing</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>${greenmail.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.eclipse.angus</groupId>
                    <artifactId>jakarta.mail</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
