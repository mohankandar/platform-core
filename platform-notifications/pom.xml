<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.documentplatform.platform</groupId>
        <artifactId>platform-core</artifactId>
        <version>1.4.0-SNAPSHOT</version>
    </parent>
    <artifactId>platform-notifications</artifactId>
    <description>Notifications capability: event catalogue, settings, routing, summaries, continuous-condition alerts,
        an outbox with retries, SMTP / Teams / Slack senders and Postgres storage. Plain Java, no Spring.</description>
    <dependencies>
        <!-- The common error-code standard: PlatformCode (texts in *.codes.properties next to each code enum). -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-errors</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SMTP sender. Jakarta Mail API + Eclipse Angus implementation (same line Spring Boot 3 uses). -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
            <version>${angus.mail.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>${greenmail.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- GreenMail brings the all-in-one Angus jar; we already have angus-mail + jakarta.mail-api. -->
                <exclusion>
                    <groupId>org.eclipse.angus</groupId>
                    <artifactId>jakarta.mail</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
