    <dependencies>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-erase-log</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Tests of the built-in case-fields handler with the in-memory field stores. -->
