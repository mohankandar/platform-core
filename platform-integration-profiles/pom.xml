<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.documentplatform.platform</groupId>
        <artifactId>platform-core</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>platform-integration-profiles</artifactId>
    <description>Ready-made integration profiles as data (JSON resources named after a published API) and their pinned
        API specifications: a profile is loaded by name into an integration configuration the app completes (address,
        sign-in, entity, field mapping, settings). First profile: sdv-ingestion-v1. No product code; the contract
        tests run against the pinned specification in every build.</description>
    <dependencies>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-integration</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-integration-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-notifications-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
