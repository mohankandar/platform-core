{
  "format": "platform-integration-profile/1",
  "name": "sdv-ingestion-v1",
  "description": "The published ingestion API sdv-ingestion-v1 (version 1.0.0): create a submission, then upload each PDF. Rules from the pinned specification (x-sdv-answers).",
  "api": {
    "spec": "sdv-ingestion-v1.openapi.json",
    "version": "1.0.0"
  },
  "kind": "API_PUSH",
  "signIn": [
    "OAUTH2_CLIENT_CREDENTIALS"
  ],
  "errorCodePointer": "/code",
  "sendCorrelationId": true,
  "testMode": "CHECK_ONLY",
  "limits": {
    "connectTimeoutMs": 10000,
    "readTimeoutMs": 120000,
    "maxFileBytes": 262144000,
    "maxDocuments": 100,
    "maxResponseBytes": 1048576,
    "maxPackageBytes": 2147483648
  },
  "fieldMapping": {
    "step": "create",
    "object": "metadata"
  },
  "documentAttributes": {
    "sensitivityLevel": {
      "values": [
        "STANDARD",
        "CONFIDENTIAL",
        "HIGHLY_CONFIDENTIAL"
      ],
      "default": "STANDARD"
    }
  },
  "settings": {
    "senderIdentity": {
      "default": "CLAIMS",
      "values": {
        "CLAIMS": {
          "token.requiredClaims": "sdv_tenant_id,sdv_source_id"
        },
        "LOOKUP": {}
      }
    }
  },
  "steps": [
    {
      "name": "create",
      "method": "POST",
      "path": "/api/v1/ingestion/submissions",
      "headers": {},
      "body": "JSON",
      "bodyTemplate": "{\"sourceSubmissionId\":\"{package.id}\",\"expectedDocumentCount\":{package.documentCount},\"expectedDocuments\":[{#each doc}{\"sourceDocumentId\":\"{doc.sourceDocumentId}\"}{/each}],\"metadata\":{}}",
      "repeat": "ONCE",
      "read": {
        "submissionId": "/submissionId",
        "submissionStatus": "/status"
      },
      "required": [
        "submissionId"
      ]
    },
    {
      "name": "upload",
      "method": "POST",
      "path": "/api/v1/ingestion/submissions/{step.create.submissionId}/documents",
      "headers": {
        "Content-Type": "application/pdf",
        "X-SDV-Filename": "{doc.fileName}",
        "X-SDV-Source-Document-Id": "{doc.sourceDocumentId}",
        "Idempotency-Key": "{doc.sourceDocumentId}",
        "X-SDV-Sensitivity-Level": "{doc.attr.sensitivityLevel}"
      },
      "body": "FILE",
      "repeat": "EACH_DOCUMENT",
      "read": {
        "documentId": "/documentId",
        "contentSha256": "/contentSha256",
        "contentSizeBytes": "/contentSizeBytes",
        "receipt": "/receiptAcknowledgement",
        "documentStatus": "/currentStatus"
      },
      "required": [
        "contentSha256",
        "contentSizeBytes",
        "documentId"
      ],
      "integrity": {
        "sha256Value": "contentSha256",
        "sizeValue": "contentSizeBytes"
      }
    }
  ],
  "rules": [
    {
      "status": "200",
      "pointer": "/receiptAcknowledgement",
      "equals": "DUPLICATE_ALREADY_STORED",
      "outcome": "ALREADY_RECEIVED"
    },
    {
      "status": "200",
      "pointer": "/idempotentReplay",
      "equals": "true",
      "outcome": "ALREADY_RECEIVED"
