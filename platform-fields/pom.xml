<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.documentplatform.platform</groupId>
        <artifactId>platform-core</artifactId>
        <version>0.8.1</version>
    </parent>
    <artifactId>platform-fields</artifactId>
    <description>Case fields (plain Java, no Spring; depends only on platform-crypto): the field model per entity and
        product (types, rules, flags), checking and normalising values with stable codes, the rules for changing a
        definition (key and type locked once values exist, removing = switching off), the field list file
        (platform-fields/1) with import by key, the field value delivery (platform-field-values/1) and its verifier,
        value storage per app record (sensitive values only encrypted, under one record envelope, searchable by exact
        match through a keyed fingerprint; one record per primary value set), search (exact, prefix, partial), and
        Postgres storage (fld_ tables, SQL in db/platform/fields, run only by the app's schema step).</description>
    <dependencies>
        <!-- The common error-code standard: PlatformCode (texts in *.codes.properties next to each code enum). -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-errors</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-crypto</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-crypto-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
