<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.documentplatform.platform</groupId>
        <artifactId>platform-core</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>platform-erase-log</artifactId>
    <description>The erase log (plain Java, no Spring, no required runtime dependencies), shared by the apps: one entry
        per erasure (entity, product, record, what was erased, when, by which rule or person, the audit record ID; never
        a value), hash-chained and numbered, kept outside the database it protects (append-only file store, written
        durably before the erase is acted on); the applied position in the app's database (erl_ table, SQL in
        db/platform/erase-log, run only by the app's schema step); the guard that keeps a restored system from taking
        work; replay through handlers per kind (case fields built in), the verify step, retention and pruning from a
        checkpoint.</description>
    <dependencies>
        <!-- The common error-code standard: PlatformCode (texts in *.codes.properties next to each code enum). -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-errors</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The built-in case-fields handler; only when the app uses platform-fields. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-fields</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- The keyed chain's built-in key (crypto.KeyServiceChainKey); only when the app uses platform-crypto. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-crypto</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-fields-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-crypto-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
