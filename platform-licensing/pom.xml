<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.documentplatform.platform</groupId>
        <artifactId>platform-core</artifactId>
        <version>0.7.0-SNAPSHOT</version>
    </parent>
    <artifactId>platform-licensing</artifactId>
    <description>Licensing capability: the signed licence (Ed25519, JDK crypto), licence states with grace, the
        effective-time clock rule and signed last-seen reset, usage levels, hash-chained usage ledger with chain head, usage
        file export, Postgres stores (plain JDBC) and SQL (db/platform/licensing), the licence-issuing command (ours) and the
        licence command (customer side). Plain Java, no Spring, no runtime dependencies.</description>
    <dependencies>
        <!-- The common error-code standard: PlatformCode (texts in *.codes.properties next to each code enum). -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-errors</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
